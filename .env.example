# Nebius Token Factory Configuration (OpenAI-compatible API)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Tavily Web Search API (Grounding for docs & changelogs)
TAVILY_API_KEY=your_tavily_api_key_here

# Verified NVIDIA Nemotron Model IDs on Nebius Token Factory
MODEL_TIER_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_TIER_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_TIER_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Cost Meter Reference Rates (USD per 1M tokens)
PRICE_ULTRA_INPUT=2.00
PRICE_ULTRA_OUTPUT=6.00
PRICE_SUPER_INPUT=0.60
PRICE_SUPER_OUTPUT=1.80
PRICE_NANO_INPUT=0.10
PRICE_NANO_OUTPUT=0.20
